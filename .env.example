# Copy to backend/.env. Never commit real secrets.
DATABASE_URL=sqlite:///./leadpilot.db
APP_ENV=development
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
COOKIE_SECURE=false
AI_MODE=rules
ALLOW_LIVE_AI=false
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
# For Docker: copy POSTGRES_PASSWORD into a root .env file and choose your own value.
# POSTGRES_PASSWORD=replace-with-a-long-random-local-password
